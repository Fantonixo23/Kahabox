{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "framework": null,
  "redirects": [
    {
      "source": "/kahabox-caja.apk",
      "destination": "https://github.com/Fantonixo23/Kahabox/releases/latest/download/kahabox-caja.apk",
      "permanent": false
    },
    {
      "source": "/kahabox-caja.json",
      "destination": "https://github.com/Fantonixo23/Kahabox/releases/latest/download/kahabox-caja.json",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}